<!-- Hero Section -->
<section class="hero d-flex flex-column justify-content-center align-items-center text-white text-center">
  <h2 class="fw-bold display-4">Meet your Artist, earn Rewards</h2>
  <p class="lead mt-3 text-center">Discover a platform designed to bridge lasting relationships between artists and music lovers. Connect with your idols, compete for rewards and discover a passionate community.</p>
  <a href="#" class="btn btn-warning btn-lg mt-4">Get Started Now</a>
</section>

<!-- Purpose Section -->
<section class="purpose py-5 text-center">
  <h3 class="fw-bold text-main-yellow mb-4">Our Purpose</h3>
  <p class="lead text-center">We exist to empower real connections between fans and artists in the digital world.</p>
</section>

<!-- Stats Section -->
<section class="container py-5">
  <p class="text-start text-main-yellow fw-bold">Explore your sound.</p>
  <h3 class="text-start text-main-yellow fw-bold mb-5 text-black">Your Listening Stats Like Never Before</h3>
  <div class="row text-start">
    <div class="col-md-4">
      <div class="stat-card bg-main-yellow text-white rounded-3 p-4">
        <p>Track Your Time</p>
        <h4>View Your Listening Habits</h4>
        <p>Get insights into your listening patterns and discover new favorites.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card bg-main-yellow text-white rounded-3 p-4">
        <p>Meaningful Rewards</p>
        <h4>Earn Customized Rewards</h4>
        <p>Meet you Artist in person, earn VIP tickets, receive special gifts and more.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card bg-main-yellow text-white rounded-3 p-4">
        <p>Join Our Community</p>
        <h4>Partner Up With Mida</h4>
        <p>Join like-minded communities and take on even more rewarding missions</p>
      </div>
    </div>
  </div>
</section>

<!-- Artists Section -->
<section class="text-center py-5">
  <h3 class="fw-bold text-main-yellow mb-5">Our Artists</h3>
  <div class="d-flex justify-content-center gap-3">
    <%= image_tag "default.jpeg", alt: "Artist 1", class: "rounded-circle", style: "width: 10vw; height: 10vw;"%>
    <%= image_tag "default.jpeg", alt: "Artist 2", class: "rounded-circle", style: "width: 10vw; height: 10vw;"%>
    <%= image_tag "default.jpeg", alt: "Artist 3", class: "rounded-circle", style: "width: 10vw; height: 10vw;"%>
    <%= image_tag "default.jpeg", alt: "Artist 4", class: "rounded-circle", style: "width: 10vw; height: 10vw;"%>
    <%= image_tag "default.jpeg", alt: "Artist 5", class: "rounded-circle", style: "width: 10vw; height: 10vw;"%>
  </div>
</section>

<!-- Signup Section -->
<section class="signup-section d-flex justify-content-center align-items-center" style="background-image: url('./assets/images/default.jpeg'); height: 50vh; background-size: cover; background-position: center;">
  <div class="signup-box bg-dark bg-opacity-75 p-5 rounded-3 text-white text-center">
    <h3 class="fw-bold">Create Your Account</h3>
    <a href="#" class="btn btn-warning btn-lg text-white mt-4">Continue with Spotify</a>
    <a href="#" class="btn btn-warning btn-lg text-white mt-3">Continue with Google</a>
  </div>
</section>
