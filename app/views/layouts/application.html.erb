<!DOCTYPE html>
<html>
<head>
  <title>Mida Music</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Bootstrap CSS via CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Fonte Poppins via Google Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap">

  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

</head>
<body>
  <!-- Navbar Comum -->
  <% unless controller_name == 'home' && action_name == 'signup' %>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
      <div class="container-fluid position-relative d-flex justify-content-between align-items-center">
        <!-- Hamburger (Toggler) always visible on the left -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Centered Brand (Logo) -->
        <a class="navbar-brand text-main-yellow fw-bold position-absolute start-50 translate-middle-x" href="/">Mida Music</a>

        <!-- Right-aligned buttons -->
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
          <ul class="navbar-nav">
            <% if current_user %>
              <li class="nav-item">
                <%= link_to 'Profile', profile_path, class: 'nav-link' %>
              </li>
              <li class="nav-item">
                <!-- Logout button -->
                <%= button_to 'Logout', logout_path, method: :delete, class: 'btn btn-outline-dark me-2' %>
              </li>
            <% else %>
              <li class="nav-item">
                <a href="/login" class="btn btn-outline-dark me-2">Log In To Mida</a>
              </li>
              <li class="nav-item">
                <a href="/signup" class="btn bg-main-yellow text-white">Become a Fan</a>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
  <% end %>

<div>
  <% if flash[:alert] %>
    <div class="alert alert-warning"><%= flash[:alert] %></div>
  <% end %>
  <%= yield %>
</div>

  <!-- Footer Global -->
  <footer class="bg-light py-4">
    <div class="container text-center">
      <!-- Horizontal line -->
      <hr class="my-4">

      <!-- Footer text and links -->
      <div class="d-flex justify-content-between align-items-center">
        <p class="mb-0">&copy; 2024 Mida Music. All rights reserved.</p>
        <p class="mb-0">
          <a href="#" class="text-dark mx-2">Privacy Policy</a>
          <a href="#" class="text-dark mx-2">Terms of Service</a>
        </p>
      </div>
    </div>
  </footer>


  <!-- Bootstrap JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
