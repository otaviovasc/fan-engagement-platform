<!DOCTYPE html>
<html>
<head>
  <title>Mida Music</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Bootstrap CSS via CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Fonte Poppins via Google Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap">

   <!-- Load signup.css only for the signup page -->
  <%= stylesheet_link_tag 'application', media: 'all' %>

</head>
<body>
  <!-- Navbar Comum -->
  <% unless controller_name == 'home' && action_name == 'signup' %>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container-fluid">
        <a class="navbar-brand text-warning fw-bold" href="/">Mida Music</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if current_user %>
              <li class="nav-item">
                <%= link_to 'Profile', profile_path, class: 'nav-link' %>
              </li>
              <li class="nav-item">
                <!-- Update logout button with DELETE method -->
                <%= button_to 'Logout', logout_path, method: :delete, class: 'nav-link' %>
              </li>
            <% else %>
              <!-- Direct login link to /auth/spotify -->
              <li class="nav-item">
                <%= button_to 'Join Mida', '/signup', method: :get, class: 'btn btn-warning text-white' %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
  <% end %>

<% unless controller_name == 'home' && action_name == 'signup' %>
  <div class="container mt-4">
    <% if flash[:alert] %>
      <div class="alert alert-warning"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </div>
<% else %>
  <%= yield %>
<% end %>

  <!-- Footer Global -->
  <footer class="bg-light py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0">&copy; 2024 Mida Music. All rights reserved.</p>
      <p class="mb-0">
        <a href="#" class="text-dark">Privacy Policy</a> |
        <a href="#" class="text-dark">Terms of Service</a> |
        <a href="#" class="text-dark">Cookie Preferences</a>
      </p>
    </div>
  </footer>

  <!-- Bootstrap JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
