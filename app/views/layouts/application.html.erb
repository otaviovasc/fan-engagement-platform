<!DOCTYPE html>
<html>
<head>
  <title>Mida Music</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Bootstrap CSS via CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Poppins Font via Google Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap">
  <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css", rel: "stylesheet", "data-turbo-track": "reload" %>

  <!-- Application CSS and Turbo -->
  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %> <!-- Ensure this is used for Importmap -->
</head>

<body>
  <!-- Navbar Comum -->
  <% unless controller_name == 'home' && action_name == 'signup' %>
    <nav class="navbar navbar-light bg-white border-bottom">
      <div class="container-fluid position-relative d-flex justify-content-between align-items-center">
        <!-- Hamburger (Toggler) - Triggers Offcanvas Sidebar -->
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Centered Brand (Logo) -->
        <a class="navbar-brand text-main-yellow fw-bold position-absolute start-50 translate-middle-x" href="/">Mida Music</a>
      </div>
    </nav>

    <!-- Offcanvas Sidebar - Visible on smaller screens -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasSidebarLabel">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav">
          <% if current_user %>
            <li class="nav-item mb-3">
              <%= link_to 'Profile', profile_path, class: 'nav-link' %>
            </li>
            <li class="nav-item mb-3">
              <%= button_to 'Logout', logout_path, method: :delete, class: 'btn btn-outline-dark' %>
            </li>
          <% else %>
            <li class="nav-item mb-3">
              <a href="/signup" class="btn btn-outline-dark">Log In To Mida</a>
            </li>
            <li class="nav-item mb-3">
              <%= link_to 'Become a fan', new_user_waitlist_path, class: 'btn bg-main-yellow text-white' %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

<div>
  <% if flash[:alert] %>
    <div class="alert alert-warning"><%= flash[:alert] %></div>
  <% end %>
  <%= yield %>
</div>

  <!-- Footer Global -->
  <footer class="bg-light py-4">
    <div class="container text-center">
      <!-- Horizontal line -->
      <hr class="my-4">

      <!-- Footer text and links -->
      <div class="d-flex justify-content-between align-items-center">
        <p class="mb-0">&copy; 2024 Mida Music. All rights reserved.</p>
        <p class="mb-0">
          <a href="/privacy" class="text-dark mx-2">Privacy Policy</a>
          <a href="/terms" class="text-dark mx-2">Terms of Service</a>
        </p>
      </div>
    </div>
  </footer>


  <!-- Bootstrap JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<style>
  .offcanvas-80 {
    width: 80%;
  }
</style>
