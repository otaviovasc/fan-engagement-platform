<i class="bi bi-1-circle"></i>
<div class="container-fluid mt-4">
  <div class="row">
    <!-- Left Sidebar -->
    <div class="col-md-3">
      <div class="card p-3">
        <div class="d-flex align-items-center mb-4">
          <!-- Profile Image -->
          <% if current_user.profile_image_url %>
            <img src="<%= current_user.profile_image_url %>" alt="Profile Image" class="rounded-circle me-3" width="60">
          <% else %>
            <%= image_tag 'default-user.png', alt:"Profile Image", class:"rounded-circle me-3", width:"60" %>
          <% end %>
          <!-- User Name -->
          <h2 class="mb-0"><%= current_user.display_name %></h2>
        </div>

        <!-- Social Media Buttons -->
        <div class="d-flex align-items-center justify-content-start mb-3">
          <!-- Spotify Status Button (2/3 space) -->
          <div class="flex-grow-1 me-2">
            <button class="btn btn-account-status" disabled
              <% if current_user.spotify_connected? %>
                style="background-color: #1DB954; color: white;"
              <% else %>
                style="border: 2px solid #000000; color: #000000;"
              <% end %>>
              Spotify
            </button>
          </div>

          <!-- YouTube Status Button (2/3 space) -->
          <div class="flex-grow-1 me-2">
            <button class="btn btn-account-status" disabled
              <% if current_user.youtube_connected? %>
                style="background-color: #FF0000; color: white;"
              <% else %>
                style="border: 2px solid #000000; color: #000000;"
              <% end %>>
              YouTube
            </button>
          </div>

          <!-- + Button (1/3 space, always yellow) -->
          <div>
            <% if !current_user.spotify_connected? %>
              <%= button_to '/auth/spotify', method: :post, data: { turbo: false }, class: 'btn btn-circle', id: 'connect-button' do %>
                <i class="fas fa-plus text-white"></i>  <!-- FontAwesome Plus Icon -->
              <% end %>
            <% elsif !current_user.youtube_connected? %>
              <%= button_to '/auth/google_oauth2', method: :post, data: { turbo: false }, class: 'btn btn-circle', id: 'connect-button' do %>
                <i class="fas fa-plus text-white"></i>  <!-- FontAwesome Plus Icon -->
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="d-flex align-content-center mt-3">
          <i class="fa-solid fa-magnifying-glass m-2" style="font-size: 1.4rem;"></i>
          <input type="text" class="form-control rounded-pill search-input" placeholder="Search your favorite artist" id="artist-search">
        </div>

        <!-- Top Artists List -->
        <h3 class="mt-4">Your Top Artists</h3>
        <ul class="list-group mt-3" id="artist-list">
          <% @top_artists.each do |artist| %>
            <li class="list-group-item d-flex align-items-center artist-item" data-artist-id="<%= artist.id %>">
              <% if artist.image_url %>
                <img src="<%= artist.image_url %>" alt="<%= artist.name %>" class="rounded-circle me-3" width="50">
              <% else %>
                <%= image_tag 'default-user.png', alt: "Artist with no image", class: "rounded-circle me-3", width: "50" %>
              <% end %>
              <span class="artist-name"><%= artist.name %></span>
            </li>
          <% end %>
        </ul>

      </div>
    </div>

    <!-- Central Section (Leaderboard) wrapped in a Turbo Frame -->
    <div class="col-md-6">
      <turbo-frame id="leaderboard">
        <div class="card p-5 text-center">
          <h3>Select an artist to see the leaderboard</h3>
        </div>
      </turbo-frame>
    </div>


    <!-- Season Rewards and Daily Missions -->
    <div class="col-md-3">
      <div class="card p-3">
        <h5 class="text-dark fw-bold">Season Rewards</h5>
        <div id="rewardCarousel" class="carousel slide reward-carousel" data-bs-ride="carousel">
          <div class="carousel-inner">
            <div class="carousel-item active text-center">
              <div class="reward-card bg-rectangle">
                <i class="fas fa-plane reward-icon mb-5"></i>
                <h6 class="text-place mb-5">1st Place</h6>
                <p>Flight To See Your Idol</p>
              </div>
            </div>
            <div class="carousel-item text-center">
              <div class="reward-card bg-rectangle">
                <i class="fas fa-music reward-icon mb-5"></i>
                <h6 class="text-place mb-5">2nd Place</h6>
                <p>Concert Tickets</p>
              </div>
            </div>
            <div class="carousel-item text-center">
              <div class="reward-card bg-rectangle">
                <i class="fas fa-headphones-alt reward-icon mb-5"></i>
                <h6 class="text-place mb-5">3rd Place</h6>
                <p>Exclusive Merchandise</p>
              </div>
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#rewardCarousel" data-bs-slide="prev">
            <i class="fa-solid fa-caret-left fs-1 text-black" aria-hidden="true"></i>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#rewardCarousel" data-bs-slide="next">
            <i class="fa-solid fa-caret-right fs-1 text-black" aria-hidden="true"></i>
          </button>
        </div>

        <h5 class="daily-missions-title">Daily Missions</h5>
        <ul class="daily-missions-list">
          <li class="mission-item highlighted">Listen to Drake Three Times <span class="points">300 Pts</span></li>
          <li class="mission-item">Repost Artists Latest Music <span class="points">200 Pts</span></li>
          <li class="mission-item">Add a Music to Your Playlist <span class="points">100 Pts</span></li>
        </ul>
      </div>
    </div>


  </div>
</div>

<script>
document.addEventListener('turbo:load', function() {
  const searchInput = document.getElementById('artist-search');
  const artistList = document.getElementById('artist-list');
  const originalArtistItems = Array.from(artistList.children); // Get a static list of the original items

  // Add click event listener to all artist items
  document.querySelectorAll('.artist-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var artistId = this.getAttribute('data-artist-id'); // Get artist ID from data attribute

      // Use Turbo to visit the artist's path and load into leaderboard frame
      Turbo.visit(`/artist/${artistId}`, { action: 'replace', frame: 'leaderboard' });

      // Clear the search input
      searchInput.value = '';

      // Reset the artist list to its original state
      artistList.innerHTML = '';
      originalArtistItems.forEach(item => artistList.appendChild(item));
    });
  });

  // Listen to input event on the search box
  searchInput.addEventListener('input', function() {
    const query = searchInput.value.toLowerCase();

    // If search query is empty, restore original list
    if (query === '') {
      artistList.innerHTML = ''; // Clear current list
      originalArtistItems.forEach(item => artistList.appendChild(item)); // Append all original items
      return;
    }

    // Otherwise, filter and display matching artists
    artistList.innerHTML = ''; // Clear current list

    originalArtistItems.forEach(function(item) {
      const artistName = item.querySelector('.artist-name').textContent.toLowerCase();
      if (artistName.includes(query)) {
        artistList.appendChild(item); // Append only matching items
      }
    });
  });
});


</script>
